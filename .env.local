# Public school website — apps/web
#
# Every value below is rendered on a public page, so all of them are NEXT_PUBLIC_*.
# Nothing secret belongs in this file.
#
# Copy to .env.local and edit. Each has a built-in fallback (see src/lib/site.ts), so the
# site still builds with none of them set — but set them per environment rather than relying
# on the fallback.

# --- Parent / staff portal -------------------------------------------------------------
# Where the "Portal" links in the top bar, the main navigation and the footer point.
# Absolute URL in production (the portal is a separate app on its own subdomain).
NEXT_PUBLIC_PORTAL_URL=http://localhost:3001

# --- Telephone ------------------------------------------------------------------------
# E.164, digits and a leading + only. The displayed form ("0806 760 4980") is derived from
# this; set NEXT_PUBLIC_SCHOOL_PHONE_DISPLAY to override the derived form.
NEXT_PUBLIC_SCHOOL_PHONE=+2348067604980
# NEXT_PUBLIC_SCHOOL_PHONE_DISPLAY=0806 760 4980

# --- WhatsApp -------------------------------------------------------------------------
# wa.me wants digits with the country code and no plus. Defaults to the telephone number
# above when unset.
NEXT_PUBLIC_SCHOOL_WHATSAPP=2348067604980

# --- Address --------------------------------------------------------------------------
# The footer prints these as two lines; the top bar and contact page join them with a comma.
NEXT_PUBLIC_SCHOOL_ADDRESS_LINE1=Mgbabor Achara, Izzi
NEXT_PUBLIC_SCHOOL_ADDRESS_LINE2=Abakaliki, Ebonyi State
# The shorter form used mid-sentence ("... at Mgbabor Achara, Izzi, Abakaliki.").
NEXT_PUBLIC_SCHOOL_ADDRESS_SHORT=Mgbabor Achara, Izzi, Abakaliki
# What the directions link and the embedded map search for.
NEXT_PUBLIC_SCHOOL_MAP_QUERY=Zion Comprehensive College Mgbabor Achara Abakaliki

# The same address broken into its parts. Never printed — search engines need it split up
# and no printed line gives them that. Region without the word "State"; country as ISO 3166.
NEXT_PUBLIC_SCHOOL_ADDRESS_STREET=Mgbabor Achara, Izzi
NEXT_PUBLIC_SCHOOL_ADDRESS_LOCALITY=Abakaliki
NEXT_PUBLIC_SCHOOL_ADDRESS_REGION=Ebonyi
NEXT_PUBLIC_SCHOOL_ADDRESS_COUNTRY=NG

# --- Canonical origin -----------------------------------------------------------------
# THE ONE THAT MATTERS FOR SEARCH. Every canonical tag, Open Graph URL, sitemap entry and
# piece of structured data is built from this. Set it to the live origin in production, with
# the scheme, no trailing slash, and the exact host you want indexed (pick www or bare and
# redirect the other to it at the web server). Getting it wrong tells Google the real pages
# live somewhere else.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# --- Search Console (optional) ---------------------------------------------------------
# The verification token from Google Search Console, if you verify by meta tag rather than
# by DNS. Unset means no tag is emitted.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Social profiles (optional) --------------------------------------------------------
# Each one that is set is declared as the same school in the page's structured data, which
# is how a profile gets tied to the site in Google's knowledge panel. Leave a line out
# rather than guessing a URL — a link to a profile that does not exist is worse than none.
# NEXT_PUBLIC_SCHOOL_FACEBOOK=https://www.facebook.com/...
# NEXT_PUBLIC_SCHOOL_INSTAGRAM=https://www.instagram.com/...
# NEXT_PUBLIC_SCHOOL_X=https://x.com/...
# NEXT_PUBLIC_SCHOOL_YOUTUBE=https://www.youtube.com/@...
# NEXT_PUBLIC_SCHOOL_LINKEDIN=https://www.linkedin.com/company/...
