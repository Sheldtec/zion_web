# Production values for zionschools.com.
#
# Committed on purpose. Every variable here is NEXT_PUBLIC_*, which means it is compiled into
# the pages and served to every visitor — none of it is secret, and none of it can be. What it
# buys is that `git clone && npm ci && npm run build` on the server produces correct canonical
# URLs with no further setup. Anything that IS secret belongs in .env.local on the server,
# which is not committed.

# The canonical origin. Every canonical tag, og:url, sitemap entry and piece of structured
# data is built from this. Pick one host and redirect the other to it at nginx.
NEXT_PUBLIC_SITE_URL=https://zionschools.com

# The school's name, as search engines and link previews should see it.
NEXT_PUBLIC_SCHOOL_NAME=Zion Comprehensive College
NEXT_PUBLIC_SCHOOL_ALT_NAME=Zion Schools

# Where the Portal links point. Update when the portal has its own address.
NEXT_PUBLIC_PORTAL_URL=https://zionschools.com/portal

# Contact details
NEXT_PUBLIC_SCHOOL_PHONE=+2348067604980
NEXT_PUBLIC_SCHOOL_WHATSAPP=2348067604980

# Address — printed form
NEXT_PUBLIC_SCHOOL_ADDRESS_LINE1=Mgbabor Achara, Izzi
NEXT_PUBLIC_SCHOOL_ADDRESS_LINE2=Abakaliki, Ebonyi State
NEXT_PUBLIC_SCHOOL_ADDRESS_SHORT=Mgbabor Achara, Izzi, Abakaliki
NEXT_PUBLIC_SCHOOL_MAP_QUERY=Zion Comprehensive College Mgbabor Achara Abakaliki

# Address — structured data only, never printed
NEXT_PUBLIC_SCHOOL_ADDRESS_STREET=Mgbabor Achara, Izzi
NEXT_PUBLIC_SCHOOL_ADDRESS_LOCALITY=Abakaliki
NEXT_PUBLIC_SCHOOL_ADDRESS_REGION=Ebonyi
NEXT_PUBLIC_SCHOOL_ADDRESS_COUNTRY=NG

# Optional, left unset until you have them:
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_SCHOOL_FACEBOOK=
# NEXT_PUBLIC_SCHOOL_INSTAGRAM=
